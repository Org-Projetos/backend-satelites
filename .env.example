# ============================================================
# Credenciais CDSE (Copernicus Data Space Ecosystem)
# Obtenha em: https://dataspace.copernicus.eu/
# ============================================================
CDSE_CLIENT_ID=seu_client_id_aqui
CDSE_CLIENT_SECRET=seu_client_secret_aqui

# ============================================================
# URLs das APIs CDSE (não altere em produção)
# ============================================================
TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
STAC_URL=https://sh.dataspace.copernicus.eu/api/v1/catalog/1.0.0/search
PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# ============================================================
# Configurações do servidor
# ============================================================
# Margem em segundos antes do token expirar para renovar (padrão: 120)
TOKEN_RENEWAL_MARGIN_SECONDS=120

# Tamanho mínimo da resposta PNG em bytes para considerar que há dados (padrão: 1500)
HAS_DATA_THRESHOLD_BYTES=1500

# Origins CORS permitidos (separados por vírgula; use * para todos em dev)
CORS_ORIGINS=["*"]

# Domínios permitidos para o proxy de thumbnail (SSRF protection)
ALLOWED_THUMBNAIL_DOMAINS=["dataspace.copernicus.eu"]

# Modo debug (False em produção)
DEBUG=False
