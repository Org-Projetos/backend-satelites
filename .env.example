# ============================================================
# Credenciais CDSE (Copernicus Data Space Ecosystem)
# Obtenha em: https://dataspace.copernicus.eu/
# ============================================================
CDSE_CLIENT_ID=seu_client_id_aqui
CDSE_CLIENT_SECRET=seu_client_secret_aqui

# ============================================================
# URLs das APIs CDSE (não altere em produção)
# ============================================================
TOKEN_URL=https://identity.dataspace.copernicus.eu/auth/realms/CDSE/protocol/openid-connect/token
STAC_URL=https://sh.dataspace.copernicus.eu/api/v1/catalog/1.0.0/search
PROCESS_URL=https://sh.dataspace.copernicus.eu/api/v1/process

# ============================================================
# Configurações do servidor
# ============================================================
# Margem em segundos antes do token expirar para renovar (padrão: 120)
TOKEN_RENEWAL_MARGIN_SECONDS=120

# Tamanho mínimo da resposta PNG em bytes para considerar que há dados (padrão: 1500)
HAS_DATA_THRESHOLD_BYTES=1500

# ============================================================
# OpenAI API (para análise via GPT-4o Vision)
# Obtenha em: https://platform.openai.com/api-keys
# ============================================================
OPENAI_API_KEY=sk-your-openai-api-key-here

# Origins CORS permitidos (separados por vírgula; use * para todos em dev)
CORS_ORIGINS=["*"]

# Domínios permitidos para o proxy de thumbnail (SSRF protection)
ALLOWED_THUMBNAIL_DOMAINS=["dataspace.copernicus.eu"]

# Modo debug (False em produção)
DEBUG=False

# ============================================================
# Rate limiting (slowapi — limite por IP)
# ============================================================
# Habilitar/desabilitar rate limiting (True em produção)
RATE_LIMIT_ENABLED=True

# Limite padrão aplicado a todas as rotas /api/* (formato: N/period)
# Exemplos: "60/minute", "1000/hour", "10/second"
RATE_LIMIT_DEFAULT=60/minute

# ============================================================
# Cache de imagens em memória (TTL)
# ============================================================
# Habilitar cache de imagens PNG geradas (reduz carga no CDSE)
IMAGE_CACHE_ENABLED=True

# Tempo de vida das entradas em segundos (padrão: 86400 = 24 horas)
IMAGE_CACHE_TTL_SECONDS=86400

# Número máximo de imagens cacheadas simultaneamente (evita uso excessivo de RAM)
IMAGE_CACHE_MAX_SIZE=200

# ============================================================
# Tiler CBERS-4A MUX
# ============================================================
# URL do catálogo STAC do CBERS-4A
CBERS4A_STAC_URL=https://stac.scitekno.com.br/v100/search

# Nome da coleção CBERS-4A MUX no catálogo STAC
CBERS4A_COLLECTION=CBERS4A_MUX_L4_DN

# Janela de busca em dias em torno da data solicitada (±N dias)
CBERS4A_TIME_WINDOW_DAYS=15
